.cursor/

# SonarQube
.sonar/

# AI-assisted development artifacts - must never be pushed
.sdd
.claude/
docs/specs
specs

# Fleet
.fleet/

# Sublime Text
*.sublime-workspace
*.sublime-project

# Vim
*.swp
*.swo
*~

# Emacs
*~
\#*\#

# macOS
.DS_Store

# Windows
Thumbs.db
Desktop.ini

# Linux
.directory

# Local .terraform directories
.terraform/

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data, such as
# password, private keys, and other secrets. These should not be part of version
# control as they are data points which are potentially sensitive and subject
# to change depending on the environment.
*.tfvars
*.tfvars.json

# Ignore override files as they are usually used to override resources locally and so
# are not checked in
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore transient lock info files created by terraform apply
.terraform.tfstate.lock.info

# Ignore CLI configuration files
.terraformrc
terraform.rc

# ignore graph output files generated by `terraform graph`
*.dot

# ignore plan files saved before destroying Terraform configuration
planout

# OCI API private key, if you keep a copy inside this folder
*.pem
