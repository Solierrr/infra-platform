# Copy this file to terraform.tfvars and fill in your own values.
# terraform.tfvars is gitignored - never commit real credentials.

tenancy_ocid      = "ocid1.tenancy.oc1..xxxxxxx"
user_ocid         = "ocid1.user.oc1..xxxxxxx"
fingerprint       = "xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx"
private_key_path  = "~/.oci/oci_api_key.pem"
region            = "sa-saopaulo-1"
compartment_ocid  = "ocid1.tenancy.oc1..xxxxxxx" # same as tenancy_ocid if you have no sub-compartments

ssh_public_key_path = "~/.ssh/id_ed25519.pub"

postgres_password   = "change-me"
mongo_root_password = "change-me"
